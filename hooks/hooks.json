{
  "hooks": {
    "UserPromptExpansion": [
      {
        "matcher": "^fairmind-coding:fairmind-coding$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT\"/hooks/scripts/front-desk-banner.sh"
          }
        ]
      },
      {
        "matcher": "^fairmind-coding:fairmind-loop$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT\"/hooks/scripts/loop-banner.sh loop"
          }
        ]
      },
      {
        "matcher": "^fairmind-coding:fairmind-develop$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT\"/hooks/scripts/loop-banner.sh develop"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT\"/hooks/scripts/validate-fairmind-path.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT\"/hooks/scripts/artifact-cards.sh gate",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT\"/hooks/scripts/artifact-cards.sh bash-gate",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT\"/hooks/scripts/inject-context.sh check",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT\"/hooks/scripts/brain-answer.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT\"/hooks/scripts/inject-context.sh",
            "statusMessage": "Loading FairMind context...",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT\"/hooks/scripts/trace-op.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT\"/hooks/scripts/brain-record-answer.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr merge *)",
            "command": "\"$CLAUDE_PLUGIN_ROOT\"/hooks/scripts/artifact-cards.sh pr-closed",
            "timeout": 20
          },
          {
            "type": "command",
            "if": "Bash(gh pr close *)",
            "command": "\"$CLAUDE_PLUGIN_ROOT\"/hooks/scripts/artifact-cards.sh pr-closed",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT\"/hooks/scripts/loop-check.sh",
            "statusMessage": "Running loop gate...",
            "timeout": 600
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT\"/hooks/scripts/capture-orchestrator-tokens.sh",
            "statusMessage": "Recording orchestrator tokens...",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT\"/hooks/scripts/check-journal.sh",
            "statusMessage": "Checking journal compliance...",
            "timeout": 600
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT\"/hooks/scripts/capture-subagent-tokens.sh",
            "statusMessage": "Recording sub-agent tokens...",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT\"/hooks/scripts/record-attestation.sh",
            "statusMessage": "Recording sub-agent attestation...",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT\"/hooks/scripts/python-floor.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT\"/hooks/scripts/session-start-insights.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT\"/hooks/scripts/artifact-cards.sh refresh",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT\"/hooks/scripts/brain-brief.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT\"/hooks/scripts/session-end-insights.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
